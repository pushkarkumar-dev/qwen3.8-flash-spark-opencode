# Settings for the scripts in scripts/. ./scripts/setup.sh copies this file to
# .env and fills in a random API key. .env is in .gitignore: never commit it.

# Clients (opencode, curl, bench.py) send this as "Authorization: Bearer <key>".
# Leave empty to run without a key (anyone on your network can then use the server).
SPARK_API_KEY=

# Recipe profile: "speed" (MTP 3, fastest) or "default" (~7% slower decode, slightly
# better on the recipe author's agentic quality tests).
PROFILE=speed

# Share of the 128 GB memory pool vLLM may take, and the max context in tokens.
# Tested pairs: 0.76 + 262144 (default here), 0.72 + 131072 (more room for other apps).
GPU_MEM=0.76
CTX=262144

# Where the Blazux recipe is cloned, and which commit.
# RECIPE_DIR=qwen3.8-Flash-DGX
# RECIPE_COMMIT=5d944b3
